{
  "name": "functions",
  "description": "Cloud Functions for WTMG",
  "license": "GPL-3.0-or-later",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "node scripts/typecheck.mjs",
    "serve": "firebase emulators:start --only functions",
    "debug": "firebase emulators:start --only functions --inspect-functions",
    "demo": "firebase --project demo-test emulators:start",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@haraka/email-address": "^3.1.6",
    "@sendgrid/client": "^8.1.6",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.112.0",
    "@turf/turf": "^7.4.0",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "email-reply-parser": "^2.3.9",
    "es6-promise-pool": "^2.5.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.0",
    "html-to-text": "^10.0.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/luxon": "^3.7.3",
    "@types/mocha": "^10.0.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "firebase-functions-test": "^3.5.0",
    "globals": "^17.9.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0",
    "typescript": "^6"
  },
  "private": true,
  "packageManager": "yarn@4.12.0"
}
