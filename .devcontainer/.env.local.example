# Copy to `.env.local` (git-ignored) and fill in.
#
# The secrets are documented in ../ci/.env.local.example, the canonical list.
# Docker-compose injects them into the container environment (`env_file`) and
# ci/fill-envs.sh materializes them into the repo's .env files on every start.
# Empty values are allowed here — the app boots without them, but e.g. map tiles
# won't render. (So `ci/check-envs.sh`, which the e2e CI job runs, is expected to
# fail in this container.)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
MAPBOX_ACCESS_TOKEN=
THUNDERFOREST_API_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Repo bootstrap (optional; used by bootstrap-repo.sh) ──────────────────────
# The repo cloned into the dev container's named volume. Override to clone a fork.
REPO_URL=https://github.com/WelcometoMyGarden/welcometomygarden.git
# GitHub Personal Access Token for private/rate-limited cloning. Injected into
# the clone URL and never written to the stored git remote.
GITHUB_PAT=
# Branch to check out (default: the remote's default branch).
REPO_BRANCH=
