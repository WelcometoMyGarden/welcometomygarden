# Canonical list of the secrets that ci/fill-envs.sh consumes.
#
# Copy to ci/.env.local (git-ignored) and fill in:
#
#   cp ci/.env.local.example ci/.env.local
#
# Two constraints on the format:
#
# - ci/check-envs.sh parses the `# [required]` / `# [optional]` markers, so keep
#   them on their own lines and keep each variable under the right one.
# - Write plain `KEY=value` with no trailing comment. `docker run --env-file`
#   does not strip those, so ` # ...` would end up inside the value.
#
# When adding a variable, also add it to the `container.env` block of
# .github/workflows/test-e2e-emulators.yml. If you don't, check-envs.sh fails
# and names it — which is the point of listing it here.

# [required]
# Empty values are substituted silently by fill-envs.sh, so they don't fail the
# build: they surface minutes later as an unexplained test failure.

# Mapbox GL access token, for the map. Empty makes mapbox-gl throw "An API
# access token is required", timing out every map-dependent test.
MAPBOX_ACCESS_TOKEN=

# Thunderforest API key, for the public-transport/rail tile overlay on the map
# (src/lib/components/Map/TrainAndRails.svelte).
THUNDERFOREST_API_KEY=

# Stripe publishable key, for the membership checkout flow.
STRIPE_PUBLISHABLE_KEY=

# Sentry/GlitchTip DSN. Becomes PUBLIC_SENTRY_DSN for the frontend, and
# fill-envs.sh splits it into the SENTRY_HOST + GLITCHTIP_KEY pair that api/.env
# expects. Being publishable, it lives in vars.SENTRY_DSN in CI rather than in
# secrets — though that makes no difference to a fork PR, which gets neither
# (GitHub withholds environment-scoped vars from forks just like secrets).
SENTRY_DSN=

# [optional]

# Sentry auth token, for source-map upload at build time. Currently inert: the
# upload integration is disabled in vite.config.ts (ENABLE_SENTRY_SOURCEMAPS).
# CI: secrets.SENTRY_AUTH_TOKEN
SENTRY_AUTH_TOKEN=


## Where these variables are used
#
# fill-envs.sh reads these from the *process environment* and substitutes them
# into the ${...} placeholders of ci/env-templates/*.env, materializing .env,
# api/.env and .env.test.local. Every environment that runs fill-envs.sh needs
# them, and each supplies them its own way:
#
# - GitHub CI e2e (.github/workflows/test-e2e-emulators.yml) — from the
#   `e2e-test-emulators` environment into the job's `container.env`. The
#   `[required]` ones below are verified by ci/check-envs.sh before the build.
# - Local e2e in the CI container (ci/local-run.sh) — `docker run --env-file
#   ci/.env.local`.
# - Dev container (.devcontainer/) — .devcontainer/.env.local, passed via the
#   docker-compose `env_file`. There *all* values are optional: the app boots
#   without them, only the features they back stop working.
